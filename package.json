{
  "name": "365-football-bot",
  "version": "0.1.0",
  "private": true,
  "description": "365 Football Bot news automation and Telegram bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cheerio": "^1.1.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "node-cron": "^4.2.1",
    "pino": "^9.7.0",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.4",
    "playwright": "^1.52.0",
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/rss-parser": "^3.0.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "pino-pretty": "^13.0.0"
  }
}

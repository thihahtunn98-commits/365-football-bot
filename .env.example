# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local development connection string. Replace with a strong, deployment-specific password.
DATABASE_URL=postgresql://football:football@localhost:5432/football?schema=public

# Telegram: create a bot with @BotFather; do not commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Comma-separated numeric Telegram IDs. Leave blank until known; the bot then denies all admin commands.
TELEGRAM_ADMIN_IDS=

# Monitoring
NEWS_POLL_CRON=*/10 * * * *
NEWS_MAX_ARTICLES_PER_SOURCE=10
RSS_REQUEST_TIMEOUT_MS=15000

# Future live score integration (not used in Phase 1)
FOOTBALL_PROVIDER=api-football
API_FOOTBALL_KEY=
